# Copy to .env and fill in. Never commit .env (gitignored).
# HF_TOKEN=hf_...

# Fixed password for the OpenCode web UI (http://localhost:8008).
# Unset => generated once into config/opencode/server-password.
# OPENCODE_PASSWORD=a-long-secret

# Host interface the model-server (6060) and OpenCode web UI (8008) are
# published on. Default 127.0.0.1; use 0.0.0.0 to expose them on the network.
# BOB_BIND=0.0.0.0

# Host directory mounted as /workspace in the OpenCode container.
# Default: this repository.
# BOB_WORKSPACE=/path/to/project
