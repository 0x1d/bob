timestamp=2026-08-15T17:35:01.102Z level=INFO run=fb41206a message=evaluated permission=bash pattern="cat > /workspace/web-fetch-search/tests/search.test.ts << 'EOF'\n/**\n * Web Search Tests\n */\n\nimport { searchWeb, searchWebFormatted } from '../src/web-search.js';\nimport type { WebSearchOptions } from '../src/types.js';\n\n// ============================================================================\n// Search Tests\n// ============================================================================\n\nconst SEARCH_TIMEOUT_MS = 10000;\n\n// Test 1: Basic search\nasync function testBasicSearch(): Promise<void> {\n  console.log('Running testBasicSearch...');\n\n  const results: any[] = [];\n  const options: WebSearchOptions = {\n    query: 'typescript',\n    maxResults: 5,\n    timeout: SEARCH_TIMEOUT_MS,\n  };\n\n  const response = await searchWeb(options);\n\n  if (!response.results || !Array.isArray(response.results)) {\n    throw new Error('Expected results array');\n  }\n\n  if (response.results.length > 0) {\n    console.log('  Found', response.results.length, 'results');\n    results.push(response);\n  }\n}\n\n// Test 2: URL fetch mode\nasync function testUrlMode(): Promise<void> {\n  console.log('Running testUrlMode...');\n\n  const results: any[] = [];\n  const options: WebSearchOptions = {\n    url: 'https://example.com',\n    maxChars: 1000,\n    convertHtmlToMarkdown: true,\n  };\n\n  const response = await searchWeb(options);\n\n  if (!response.results || !Array.isArray(response.results)) {\n    throw new Error('Expected results array');\n  }\n\n  if (response.results.length > 0) {\n    console.log('  URL fetch succeeded, got', response.results.length, 'chars of content');\n    results.push(response);\n  }\n}\n\n// Test 3: Invalid URL\nasync function testInvalidUrl(): Promise<void> {\n  console.log('Running testInvalidUrl...');\n\n  const options: WebSearchOptions = {\n    url: 'https://invalid.example',\n    timeout: 2000,\n  };\n\n  const response = await searchWeb(options);\n\n  // Should return an error in results or empty array\n  console.log('  Invalid URL handled, results:', response.results?.length || 0);\n}\n\n// Test 4: Empty query\nasync function testEmptyQuery(): Promise<void> {\n  console.log('Running testEmptyQuery...');\n\n  const options: WebSearchOptions = {\n    query: '',\n    maxResults: 5,\n  };\n\n  const response = await searchWeb(options);\n\n  if (response.results?.length !== 0) {\n    throw new Error('Empty query should return empty results');\n  }\n  console.log('  Empty query correctly returned empty results');\n}\n\n// Test 5: Formatting tests\nasync function testFormatting(): Promise<void> {\n  console.log('Running testFormatting...');\n\n  const results: any[] = [];\n\n  // Default format\n  const defaultFormat = await searchWebFormatted('node.js', 'default', {\n    maxResults: 3,\n    timeout: 5000,\n  });\n  if (defaultFormat.results?.length > 0) {\n    console.log('  Default format:', defaultFormat.results.length, 'results');\n    results.push(defaultFormat);\n  }\n\n  // JSON format\n  const jsonFormat = await searchWebFormatted('node.js', 'json', {\n    maxResults: 3,\n    timeout: 5000,\n  });\n  if (jsonFormat.results?.length > 0) {\n    console.log('  JSON format:', jsonFormat.results.length, 'results');\n    results.push(jsonFormat);\n  }\n\n  // Markdown format\n  const markdownFormat = await searchWebFormatted('node.js', 'markdown', {\n    maxResults: 3,\n    timeout: 5000,\n  });\n  if (markdownFormat.results?.length > 0) {\n    console.log('  Markdown format:', markdownFormat.results.length, 'results');\n    results.push(markdownFormat);\n  }\n}\n\n// ============================================================================\n// Integration Tests\n// ============================================================================\n\nasync function runSearchTests(): Promise<void> {\n  console.log('=== Web Search Tests ===\\n');\n\n  try {\n    await testBasicSearch();\n    console.log();\n  } catch (e: any) {\n    console.error('  testBasicSearch failed:', e.message);\n  }\n\n  try {\n    await testUrlMode();\n    console.log();\n  } catch (e: any) {\n    console.error('  testUrlMode failed:', e.message);\n  }\n\n  try {\n    await testInvalidUrl();\n    console.log();\n  } catch (e: any) {\n    console.error('  testInvalidUrl failed:', e.message);\n  }\n\n  try {\n    await testEmptyQuery();\n    console.log();\n  } catch (e: any) {\n    console.error('  testEmptyQuery failed:', e.message);\n  }\n\n  try {\n    await testFormatting();\n    console.log();\n  } catch (e: any) {\n    console.error('  testFormatting failed:', e.message);\n  }\n\n  console.log('=== All Search Tests Complete ===');\n}\n\nif (import.meta.url === `file://${process.argv[1]}`) {\n  runSearchTests();\n}\nEOF" action.permission=* action.action=allow action.pattern=*
