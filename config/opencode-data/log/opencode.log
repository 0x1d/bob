timestamp=2026-08-15T17:33:33.277Z level=INFO run=fb41206a message=evaluated permission=bash pattern="cat > /workspace/web-fetch-search/src/html-parser.ts << 'EOF'\n/**\n * HTML to Markdown Parser\n * Minimal HTML-to-Markdown converter using only Node.js built-ins\n * Replaces external html2text dependency\n */\n\nexport interface HtmlToMarkdownOptions {\n  /** Whether to scope conversion to the main content subtree (readability-style) */\n  mainContent?: boolean;\n\n  /** Whether to strip boilerplate page furniture */\n  stripBoilerplate?: boolean;\n}\n\n// ============================================================================\n// Boilerplate Fragments\n// ============================================================================\n\nconst BOILERPLATE_FRAGMENTS = [\n  'skip to content',\n  'skip to main content',\n  'there was an error while loading',\n  'please reload this page',\n  'you can\\'t perform that action at this time',\n  'you signed in with another tab or window',\n  'you signed out in another tab or window',\n  'you switched accounts on another tab or window',\n  'reload to refresh your session',\n  'uh oh!',\n  'this website uses cookies',\n  'we use cookies',\n  'accept all cookies',\n  'manage cookie preferences',\n];\n\nconst BOILERPLATE_NORMALIZED = new Set(\n  BOILERPLATE_FRAGMENTS\n    .map((f) => f.trim().toLowerCase().replace(/\\s+/g, ' ').replace(/[.!]+$/, ''))\n);\n\nfunction isBoilerplateLine(line: string): boolean {\n  const normalized = line.trim().toLowerCase().replace(/\\s+/g, ' ').replace(/[.!]+$/, '');\n  if (!normalized) return false;\n  // Split on sentence terminators and require every segment to be furniture\n  const segments = normalized\n    .split(/[.!]/)\n    .map((s) => s.trim().replace(/[.!]+$/, ''))\n    .filter(Boolean);\n  return segments.length > 0 && segments.every((s) => BOILERPLATE_NORMALIZED.has(s));\n}\n\nfunction stripBoilerplate(text: string): string {\n  const lines = text.split('\\n').filter(Boolean);\n  const out: string[] = [];\n  let inFenced = 0;\n\n  for (const line of lines) {\n    const stripped = line.trim();\n\n    if (stripped === '```' || stripped === '~~~') {\n      inFenced = inFenced ? 0 : Math.max(3, inFenced + 1);\n      out.push(line);\n      continue;\n    }\n\n    if (inFenced > 0) {\n      out.push(line);\n      continue;\n    }\n\n    // Strip boilerplate lines (short lines only)\n    if (line.length <= 300 && isBoilerplateLine(line)) {\n      continue;\n    }\n\n    out.push(line);\n  }\n\n  return out.join('\\n');\n}\n\n// ============================================================================\n// HTML Parser\n// ============================================================================\n\nconst SKIP_TAGS = new Set([\n  'script', 'style', 'head', 'noscript', 'svg', 'math', 'nav', 'footer',\n  'template', 'dialog', 'button', 'select', 'datalist', 'iframe', 'object'\n]);\n\nconst VOID_TAGS = new Set([\n  'area', 'base', 'br', 'col', 'embed', 'hr', 'img', 'input', 'link',\n  'meta', 'param', 'source', 'track', 'wbr', 'area'\n]);\n\nconst HEADING_TAGS = ['h1', 'h2', 'h3', 'h4', 'h5', 'h6'];\n\nconst INLINE_EMPHASIS: Record<string, string> = {\n  strong: '**',\n  b: '**',\n  em: '*',\n  i: '*',\n};\n\nconst BLOCK_TAGS = new Set([\n  'p', 'div', 'section', 'article', 'main', 'aside', 'figure',\n  'details', 'summary', 'dl', 'dt', 'dd'\n]);\n\nfunction isHiddenElement(attrDict: Record<string, string>): boolean {\n  if (attrDict.hidden) return true;\n  if (attrDict['aria-hidden'] === 'true') return true;\n  const style = attrDict.style || '';\n  if (!style) return false;\n  const lowered = style.toLowerCase();\n  if ('none' in lowered || 'hidden' in lowered) {\n    for (const decl of style.split(';')) {\n      const [prop, sep, value] = decl.split(':');\n      if (!sep) continue;\n      const propN = prop.trim().toLowerCase();\n      const valueN = value.split('!')[0].trim().toLowerCase();\n      if (propN === 'display' && valueN === 'none') return true;\n      if (propN === 'visibility' && valueN === 'hidden') return true;\n    }\n  }\n  return false;\n}\n\n// ============================================================================\n// Main Converter\n// ============================================================================\n\nexport interface MarkdownOutput {\n  out: string[];\n}\n\nclass HtmlToMarkdown {\n  private out: string[] = [];\n  private inPre: boolean = false;\n  private inCode: boolean = false;\n  private inLink: boolean = false;\n  private linkText: string[] = [];\n  private linkHref: string | null = null;\n  private linkSeq: number = 0;\n  private linkHadHeading: boolean = false;\n  private headingMarks: boolean[] = [];\n  private headingParts: string[] = [];\n  private bqStack: string[][] = [];\n  private listStack: string[] = [];\n  private olCounter: number[] = [];\n  private inTable: boolean = false;\n  private currentRow: string[] = [];\n  private cellParts: string[] = [];\n  private inCell: boolean = false;\n  private headerStack: { parts: string[]; headingParts: string[] }[] = [];\n\n  constructor(private options: HtmlToMarkdownOptions) {\n    this.mainContent = options.mainContent || false;\n    this.stripBoilerplate = options.stripBoilerplate || false;\n  }\n\n  get mainContent(): boolean { return this.mainContent; }\n  get stripBoilerplate(): boolean { return this.stripBoilerplate; }\n\n  feed(html: string): void {\n    this._reset();\n    this._parse(html);\n  }\n\n  private _reset(): void {\n    this.out = [];\n    this.inPre = false;\n    this.inCode = false;\n    this.inLink = false;\n    this.linkText = [];\n    this.linkHref = null;\n    this.linkSeq = 0;\n    this.linkHadHeading = false;\n    this.headingMarks = [];\n    this.headingParts = [];\n    this.bqStack = [];\n    this.listStack = [];\n    this.olCounter = [];\n    this.inTable = false;\n    this.currentRow = [];\n    this.cellParts = [];\n    this.inCell = false;\n    this.headerStack = [];\n  }\n\n  private _emit(text: string): void {\n    if (!text) return;\n    this.out.push(text);\n  }\n\n  private _emitEmphasis(mark: string): void {\n    this._emit(mark);\n  }\n\n  private _handleData(data: string): void {\n    // Preserve whitespace in pre/code\n    if (this.inPre || this.inCode) {\n      this._emit(data);\n      return;\n    }\n    // Normalize whitespace\n    const text = data.replace(/[\\t\\n\\r]+/g, ' ').trim();\n    if (text) {\n      this._emit(text);\n    }\n  }\n\n  private _handleStartTag(tag: string, attrs: Record<string, string> = {}): void {\n    const tagLower = tag.toLowerCase();\n\n    // Skip tags\n    if (SKIP_TAGS.has(tagLower)) {\n      return;\n    }\n\n    // Hidden elements\n    if (isHiddenElement(attrs)) {\n      return;\n    }\n\n    // Headings\n    if (HEADING_TAGS.includes(tagLower)) {\n      this._emit('\\n\\n');\n      this._emit('#'.repeat(parseInt(tagLower.slice(1)) + 1) + ' ');\n      return;\n    }\n\n    // Emphasis\n    if (INLINE_EMPHASIS.hasOwnProperty(tagLower)) {\n      this._emitEmphasis(INLINE_EMPHASIS[tagLower]);\n      return;\n    }\n\n    // Links\n    if (tagLower === 'a') {\n      this.linkHref = attrs.href;\n      this.linkText = [];\n      this.linkSeq++;\n      return;\n    }\n\n    // Line breaks\n    if (tagLower === 'br') {\n      this._emit('\\n');\n      return;\n    }\n\n    // Block elements\n    if (BLOCK_TAGS.has(tagLower)) {\n      this._emit('\\n\\n');\n      return;\n    }\n\n    // Horizontal rule\n    if (tagLower === 'hr') {\n      this._emit('\\n\\n---\\n\\n');\n      return;\n    }\n\n    // Blockquotes\n    if (tagLower === 'blockquote') {\n      this._emit('\\n\\n');\n      this.bqStack.push([]);\n      return;\n    }\n\n    // Lists\n    if (tagLower === 'ul') {\n      this.listStack.push('ul');\n      this._emit('\\n');\n      return;\n    }\n\n    if (tagLower === 'ol') {\n      this.listStack.push('ol');\n      this.olCounter.push(0);\n      this._emit('\\n');\n      return;\n    }\n\n    if (tagLower === 'li') {\n      const indent = '  '.repeat(Math.max(0, this.listStack.length - 1));\n      const marker = this.listStack.length > 0 && this.listStack[this.listStack.length - 1] === 'ol'\n        ? `${this.olCounter[this.olCounter.length - 1] + 1}. ` as const\n        : '* ' as const;\n      this._emit(indent + marker);\n      return;\n    }\n\n    // Pre\n    if (tagLower === 'pre') {\n      this.inPre = true;\n      return;\n    }\n\n    // Code\n    if (tagLower === 'code') {\n      this.inCode = true;\n      this._emit('`');\n      return;\n    }\n\n    // Tables\n    if (tagLower === 'table') {\n      this.inTable = true;\n      this._emit('\\n\\n');\n      return;\n    }\n\n    if (tagLower === 'tr') {\n      this.cellParts = [];\n      this.inCell = false;\n      return;\n    }\n\n    if (tagLower === 'th' || tagLower === 'td') {\n      this.cellParts = [];\n      this.inCell = true;\n      return;\n    }\n  }\n\n  private _handleEndTag(tag: string): void {\n    const tagLower = tag.toLowerCase();\n\n    // Headings\n    if (HEADING_TAGS.includes(tagLower)) {\n      this._emit('\\n\\n');\n      return;\n    }\n\n    // Links\n    if (tagLower === 'a') {\n      if (this.linkText.length > 0 && this.linkHref) {\n        const text = this.linkText.join('').trim().replace(/[\\s]+/g, ' ');\n        this._emit(`[${text}](${this.linkHref})`);\n      } else if (this.linkText.length > 0) {\n        this._emit(this.linkText.join('').trim());\n      }\n      this.linkText = [];\n      this.linkHref = null;\n      return;\n    }\n\n    // Emphasis\n    if (INLINE_EMPHASIS.hasOwnProperty(tagLower)) {\n      this._emitEmphasis(INLINE_EMPHASIS[tagLower]);\n      return;\n    }\n\n    // Line breaks\n    if (tagLower === 'br') {\n      this._emit('\\n');\n      return;\n    }\n\n    // Block elements\n    if (BLOCK_TAGS.has(tagLower)) {\n      this._emit('\\n\\n');\n      return;\n    }\n\n    // Blockquotes\n    if (tagLower === 'blockquote') {\n      if (this.bqStack.length > 0) {\n        const content = this.bqStack[this.bqStack.length - 1].join('\\n');\n        this.bqStack.pop();\n        this._emit(this._prefixBlockquote(content) + '\\n\\n');\n      }\n      return;\n    }\n\n    // Lists\n    if (tagLower === 'ul') {\n      this.listStack.pop();\n      this._emit('\\n');\n      return;\n    }\n\n    if (tagLower === 'ol') {\n      this.listStack.pop();\n      if (this.olCounter.length > 0) {\n        this.olCounter.pop();\n      }\n      this._emit('\\n');\n      return;\n    }\n\n    if (tagLower === 'pre') {\n      this.inPre = false;\n      return;\n    }\n\n    if (tagLower === 'code') {\n      this.inCode = false;\n      this._emit('`');\n      return;\n    }\n\n    if (tagLower === 'tr') {\n      if (this.cellParts.length > 0) {\n        const cell = this.cellParts.join('').trim().replace(/\\|/g, '\\\\|');\n        this.currentRow.push(cell);\n        this.cellParts = [];\n      }\n      return;\n    }\n\n    if (tagLower === 'th' || tagLower === 'td') {\n      if (this.cellParts.length > 0) {\n        const cell = this.cellParts.join('').trim().replace(/\\|/g, '\\\\|');\n        this.currentRow.push(cell);\n        this.cellParts = [];\n      }\n      return;\n    }\n\n    if (tagLower === 'table') {\n      if (this.currentRow.length > 0) {\n        const line = '| ' + this.currentRow.join(' | ') + ' |';\n        this._emit(line + '\\n');\n        const sep = '| ' + ' | '.repeat(this.currentRow.length) + ' |';\n        this._emit(sep + '\\n');\n      }\n      this.inTable = false;\n      this._emit('\\n');\n      return;\n    }\n  }\n\n  private _prefixBlockquote(content: string): string {\n    const lines = content.split('\\n').filter(l => l.trim().length > 0);\n    if (lines.length === 0) return '';\n    const prefixed: string[] = [];\n    for (const line of lines) {\n      prefixed.push('> ' + line);\n    }\n    return prefixed.join('\\n');\n  }\n\n  _parse(html: string): void {\n    this._reset();\n    this._resetState();\n\n    // Normalize newlines\n    html = html.replace(/\\r\\n/g, '\\n').replace(/\\r/g, '\\n');\n\n    // Tokenize\n    let i = 0;\n    while (i < html.length) {\n      // Handle data\n      while (i < html.length && html[i] !== '<') {\n        this._handleData(html[i]);\n        i++;\n      }\n      if (i >= html.length) break;\n\n      // Handle tags\n      let j = i;\n      while (j < html.length && html[j] !== '>') j++;\n      if (j >= html.length) break;\n\n      const tag = html.substring(i, j + 1);\n      const slash = tag[1] === '/';\n      const tagEnd = tag.indexOf('>') !== -1 ? tag.indexOf('>') : j;\n      const tagContent = tag.substring(1, tagEnd);\n\n      const parts = tagContent.split(/\\s+/);\n      const tagName = parts[0] || '';\n      const attrs: Record<string, string> = {};\n\n      for (let k = 1; k < parts.length; k++) {\n        const part = parts[k];\n        if (part.startsWith('data-')) {\n          const [key, ...valueParts] = part.split('=');\n          const value = valueParts.join('=').replace(/^\"|\"$/g, '');\n          attrs[key] = value;\n          continue;\n        }\n        if (part.startsWith('href=\"') || part.startsWith('href=')) {\n          const href = part.split('=')[1] || '';\n          attrs.href = href.replace(/^\"|\"$/g, '');\n          continue;\n        }\n      }\n\n      if (slash) {\n        this._handleEndTag(tagName);\n        i = j + 1;\n        continue;\n      }\n\n      this._handleStartTag(tagName, attrs);\n      i = j + 1;\n    }\n\n    // Flush\n    this._flush();\n  }\n\n  private _flush(): void {\n    this._emit('\\n\\n' + stripBoilerplate(this.out.join('')));\n  }\n\n  static htmlToMarkdown(html: string, options: HtmlToMarkdownOptions = {}): string {\n    const parser = new HtmlToMarkdown(options);\n    parser.feed(html);\n    return parser.out.join('');\n  }\n}\n\nexport { HtmlToMarkdown };\nEOF" action.permission=* action.action=allow action.pattern=*
