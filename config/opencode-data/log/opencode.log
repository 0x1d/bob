timestamp=2026-08-15T17:35:47.166Z level=INFO run=fb41206a message=evaluated permission=bash pattern="cat > /workspace/web-fetch-search/tests/fetch.test.ts << 'EOF'\n/**\n * Web Fetch Tests\n */\n\nimport { fetchUrl, fetchUrlWithProgress } from '../src/web-fetch.js';\nimport type { WebFetchOptions } from '../src/types.js';\n\n// ============================================================================\n// Fetch Tests\n// ============================================================================\n\nconst FETCH_TIMEOUT_MS = 10000;\n\n// Test 1: Simple fetch\nasync function testSimpleFetch(): Promise<void> {\n  console.log('Running testSimpleFetch...');\n\n  const results: any[] = [];\n  const options: WebFetchOptions = {\n    url: 'https://example.com',\n    maxChars: 200,\n    timeout: FETCH_TIMEOUT_MS,\n  };\n\n  const response = await fetchUrl(options);\n\n  if (response.success) {\n    console.log('  Fetched successfully, got', response.content?.length || 0, 'chars');\n    results.push(response);\n  } else {\n    console.log('  Fetch failed:', response.error);\n  }\n}\n\n// Test 2: Markdown conversion\nasync function testMarkdownConversion(): Promise<void> {\n  console.log('Running testMarkdownConversion...');\n\n  const results: any[] = [];\n  const options: WebFetchOptions = {\n    url: 'https://example.com',\n    maxChars: 500,\n    timeout: FETCH_TIMEOUT_MS,\n    convertHtmlToMarkdown: true,\n  };\n\n  const response = await fetchUrl(options);\n\n  if (response.success && response.content) {\n    console.log('  Markdown conversion:', response.convertedFromHtml || false);\n    console.log('  Content length:', response.content.length);\n    results.push(response);\n  }\n}\n\n// Test 3: Non-existent URL\nasync function testNonExistentUrl(): Promise<void> {\n  console.log('Running testNonExistentUrl...');\n\n  const options: WebFetchOptions = {\n    url: 'https://httpbin.org/status/404',\n    timeout: 2000,\n  };\n\n  const response = await fetchUrl(options);\n\n  // Should return an error for HTTP 404\n  console.log('  Non-existent URL handled, error:', response.error?.substring(0, 100));\n}\n\n// Test 4: Private IP SSRF protection\nasync function testSsrfProtection(): Promise<void> {\n  console.log('Running testSsrfProtection...');\n\n  const options: WebFetchOptions = {\n    url: 'http://127.0.0.1',\n    timeout: 2000,\n  };\n\n  const response = await fetchUrl(options);\n\n  // Should block private IPs\n  console.log('  SSRF protection result, success:', response.success);\n}\n\n// Test 5: Empty URL\nasync function testEmptyUrl(): Promise<void> {\n  console.log('Running testEmptyUrl...');\n\n  const options: WebFetchOptions = {\n    url: 'about:blank',\n    timeout: 2000,\n  };\n\n  const response = await fetchUrl(options);\n\n  // Should handle invalid schemes\n  console.log('  Empty URL handled, success:', response.success);\n}\n\n// Test 6: URL with scheme\nasync function testUrlWithScheme(): Promise<void> {\n  console.log('Running testUrlWithScheme...');\n\n  const results: any[] = [];\n  const options: WebFetchOptions = {\n    url: 'https://example.com/test',\n    maxChars: 100,\n    timeout: 5000,\n  };\n\n  const response = await fetchUrl(options);\n\n  if (response.success && response.content) {\n    console.log('  Schemed URL fetched, length:', response.content.length);\n    results.push(response);\n  } else {\n    console.log('  Schemed URL error:', response.error?.substring(0, 50));\n  }\n}\n\n// ============================================================================\n// Progress Callback Test\n// ============================================================================\n\nasync function testProgressCallback(): Promise<void> {\n  console.log('Running testProgressCallback...');\n\n  const progressChunks: string[] = [];\n  const options: WebFetchOptions = {\n    url: 'https://example.com',\n    maxChars: 200,\n    timeout: FETCH_TIMEOUT_MS,\n    onProgress: (chunk) => {\n      progressChunks.push(chunk);\n    },\n  };\n\n  const response = await fetchUrl(options);\n\n  console.log('  Progress chunks captured:', progressChunks.length);\n}\n\n// ============================================================================\n// Retry Test\n// ============================================================================\n\nasync function testRetry(): Promise<void> {\n  console.log('Running testRetry...');\n\n  const options: WebFetchOptions = {\n    url: 'https://example.com',\n    maxChars: 100,\n    timeout: 3000,\n    maxRetries: 2,\n    backoffDelay: 100,\n  };\n\n  const response = await fetchUrl(options);\n\n  console.log('  Retry test completed, success:', response.success);\n}\n\n// ============================================================================\n// Main Test Runner\n// ============================================================================\n\nasync function runFetchTests(): Promise<void> {\n  console.log('=== Web Fetch Tests ===\\n');\n\n  try {\n    await testSimpleFetch();\n    console.log();\n  } catch (e: any) {\n    console.error('  testSimpleFetch failed:', e.message);\n  }\n\n  try {\n    await testMarkdownConversion();\n    console.log();\n  } catch (e: any) {\n    console.error('  testMarkdownConversion failed:', e.message);\n  }\n\n  try {\n    await testNonExistentUrl();\n    console.log();\n  } catch (e: any) {\n    console.error('  testNonExistentUrl failed:', e.message);\n  }\n\n  try {\n    await testSsrfProtection();\n    console.log();\n  } catch (e: any) {\n    console.error('  testSsrfProtection failed:', e.message);\n  }\n\n  try {\n    await testEmptyUrl();\n    console.log();\n  } catch (e: any) {\n    console.error('  testEmptyUrl failed:', e.message);\n  }\n\n  try {\n    await testUrlWithScheme();\n    console.log();\n  } catch (e: any) {\n    console.error('  testUrlWithScheme failed:', e.message);\n  }\n\n  try {\n    await testProgressCallback();\n    console.log();\n  } catch (e: any) {\n    console.error('  testProgressCallback failed:', e.message);\n  }\n\n  try {\n    await testRetry();\n    console.log();\n  } catch (e: any) {\n    console.error('  testRetry failed:', e.message);\n  }\n\n  console.log('=== All Fetch Tests Complete ===');\n}\n\nif (import.meta.url === `file://${process.argv[1]}`) {\n  runFetchTests();\n}\nEOF" action.permission=* action.action=allow action.pattern=*
