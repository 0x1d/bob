timestamp=2026-08-15T17:29:54.584Z level=INFO run=fb41206a message=evaluated permission=bash pattern="cat > /workspace/web-fetch-search/src/types.ts << 'EOF'\n/**\n * Web Search & Fetch Types\n */\n\n// ============================================================================\n// Web Search Options\n// ============================================================================\n\nexport interface WebSearchOptions {\n  /** Maximum number of search results to return */\n  maxResults?: number;\n\n  /** Timeout in milliseconds for the search request */\n  timeout?: number;\n\n  /** Search query to use */\n  query?: string;\n\n  /** URL to fetch directly instead of searching (url mode) */\n  url?: string;\n\n  /** Maximum characters to return from a URL fetch */\n  maxChars?: number;\n\n  /** Maximum milliseconds to wait for a URL fetch */\n  fetchTimeout?: number;\n\n  /** Whether to respect a provided website policy */\n  websitePolicy?: WebsitePolicy;\n\n  /** Number of retry attempts on failure */\n  maxRetries?: number;\n\n  /** Backoff delay in milliseconds between retries */\n  backoffDelay?: number;\n\n  /** Callback invoked with incremental output during fetch */\n  onProgress?: (chunk: string) => void;\n\n  /** Whether to convert HTML pages to Markdown */\n  convertHtmlToMarkdown?: boolean;\n}\n\n// ============================================================================\n// Web Fetch Options\n// ============================================================================\n\nexport interface WebFetchOptions {\n  /** URL to fetch */\n  url: string;\n\n  /** Maximum characters to return from the page */\n  maxChars?: number;\n\n  /** Timeout in milliseconds for the fetch */\n  timeout?: number;\n\n  /** Callback invoked with incremental output during fetch */\n  onProgress?: (chunk: string) => void;\n\n  /** Whether to convert HTML to Markdown */\n  convertHtmlToMarkdown?: boolean;\n\n  /** Website access policy */\n  websitePolicy?: WebsitePolicy;\n\n  /** Number of retry attempts on failure */\n  maxRetries?: number;\n\n  /** Backoff delay in milliseconds between retries */\n  backoffDelay?: number;\n}\n\n// ============================================================================\n// Website Policy\n// ============================================================================\n\nexport interface WebsitePolicy {\n  /** Domains explicitly allowed for search/fetch */\n  allowedDomains?: string[];\n\n  /** Domains explicitly blocked for search/fetch */\n  blockedDomains?: string[];\n}\n\n// ============================================================================\n// Search Results\n// ============================================================================\n\nexport interface SearchResult {\n  /** Title of the result */\n  title: string;\n\n  /** URL of the result */\n  url: string;\n\n  /** Snippet / description */\n  snippet: string;\n\n  /** Additional metadata */\n  [key: string]: unknown;\n}\n\nexport interface SearchResponse {\n  /** Array of search results */\n  results: SearchResult[];\n\n  /** Number of results returned */\n  count: number;\n\n  /** Query that was searched */\n  query?: string;\n}\n\nexport interface UrlFetchResult {\n  /** Whether the fetch succeeded */\n  success: boolean;\n\n  /** Error message if failed */\n  error?: string;\n\n  /** The fetched content */\n  content?: string;\n\n  /** Content type / MIME type */\n  contentType?: string;\n\n  /** URL that was fetched */\n  url: string;\n\n  /** Whether the content was converted from HTML to Markdown */\n  convertedFromHtml?: boolean;\n\n  /** Raw content type header */\n  rawContentType?: string;\n}\n\n// ============================================================================\n// Caching\n// ============================================================================\n\nexport interface CacheConfig {\n  /** Size in MB for the in-memory cache */\n  maxSizeMB?: number;\n\n  /** TTL in seconds for search results */\n  searchTtlSeconds?: number;\n\n  /** TTL in seconds for URL fetch results */\n  fetchTtlSeconds?: number;\n\n  /** Whether to enable cache */\n  enabled?: boolean;\n}\nEOF" action.permission=* action.action=allow action.pattern=*
