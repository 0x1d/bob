timestamp=2026-08-15T17:39:01.681Z level=INFO run=fb41206a message=evaluated permission=bash pattern="cat > /workspace/web-fetch-search/tests/standalone.test.ts << 'EOF'\n/**\n * Standalone Tests - No npm dependencies required\n * Tests basic functionality of the web-fetch-search library\n */\n\nimport { searchWeb, fetchUrl } from '../src/web-search.js';\nimport { fetchUrl as _fetchUrl, fetchUrlWithProgress } from '../src/web-fetch.js';\n\n// ============================================================================\n// Search Tests\n// ============================================================================\n\nconsole.log('=== Search Tests ===\\n');\n\nasync function testSearch(): Promise<void> {\n  console.log('Testing basic search...');\n\n  const options: any = {\n    query: 'typescript',\n    maxResults: 5,\n    timeout: 8000,\n  };\n\n  const response: any = await searchWeb(options);\n  console.log('  Results count:', response.results?.length || 0);\n  console.log('  Query:', response.query);\n  console.log('  Success!');\n  console.log();\n}\n\nasync function testUrlMode(): Promise<void> {\n  console.log('Testing URL fetch mode...');\n\n  const options: any = {\n    url: 'https://example.com',\n    maxChars: 100,\n    convertHtmlToMarkdown: true,\n  };\n\n  const response: any = await searchWeb(options);\n  console.log('  URL mode success:', response.success);\n  console.log('  Content length:', response.content?.length || 0);\n  console.log();\n}\n\nasync function testEmptyQuery(): Promise<void> {\n  console.log('Testing empty query handling...');\n\n  const options: any = {\n    query: '',\n    maxResults: 5,\n  };\n\n  const response: any = await searchWeb(options);\n  console.log('  Results count:', response.results?.length || 0);\n  console.log('  Expected: 0');\n  console.log();\n}\n\n// ============================================================================\n// Fetch Tests\n// ============================================================================\n\nconsole.log('\\n=== Fetch Tests ===\\n');\n\nasync function testFetch(): Promise<void> {\n  console.log('Testing simple fetch...');\n\n  const options: any = {\n    url: 'https://example.com',\n    maxChars: 200,\n    timeout: 10000,\n  };\n\n  const response: any = await fetchUrl(options);\n  console.log('  Success:', response.success);\n  console.log('  Error:', response.error || null);\n  console.log('  Content length:', response.content?.length || 0);\n  console.log('  Content type:', response.contentType);\n  console.log();\n}\n\nasync function testMarkdownConversion(): Promise<void> {\n  console.log('Testing markdown conversion...');\n\n  const options: any = {\n    url: 'https://example.com',\n    maxChars: 300,\n    timeout: 10000,\n    convertHtmlToMarkdown: true,\n  };\n\n  const response: any = await fetchUrl(options);\n  console.log('  Converted from HTML:', response.convertedFromHtml || false);\n  console.log('  Content preview:', response.content?.substring(0, 100));\n  console.log();\n}\n\nasync function testNonExistentUrl(): Promise<void> {\n  console.log('Testing non-existent URL...');\n\n  const options: any = {\n    url: 'https://example.com/nonexistent',\n    timeout: 3000,\n  };\n\n  const response: any = await fetchUrl(options);\n  console.log('  Success:', response.success);\n  console.log('  Error:', response.error?.substring(0, 50) || null);\n  console.log();\n}\n\nasync function testPrivateIp(): Promise<void> {\n  console.log('Testing private IP blocking (SSRF)...');\n\n  const options: any = {\n    url: 'http://127.0.0.1',\n    timeout: 2000,\n  };\n\n  const response: any = await fetchUrl(options);\n  console.log('  Success:', response.success);\n  console.log('  Error:', response.error?.substring(0, 50) || null);\n  console.log();\n}\n\nasync function testValidUrl(): Promise<void> {\n  console.log('Testing valid external URL...');\n\n  const options: any = {\n    url: 'https://www.typescriptlang.org',\n    maxChars: 1000,\n    timeout: 10000,\n  };\n\n  const response: any = await fetchUrl(options);\n  console.log('  Success:', response.success);\n  console.log('  Content length:', response.content?.length || 0);\n  console.log('  First 200 chars:', response.content?.substring(0, 200));\n  console.log();\n}\n\nasync function runAllTests(): Promise<void> {\n  try {\n    await testSearch();\n  } catch (e: any) {\n    console.error('  Error:', e.message);\n  }\n\n  try {\n    await testUrlMode();\n  } catch (e: any) {\n    console.error('  Error:', e.message);\n  }\n\n  try {\n    await testEmptyQuery();\n  } catch (e: any) {\n    console.error('  Error:', e.message);\n  }\n\n  try {\n    await testFetch();\n  } catch (e: any) {\n    console.error('  Error:', e.message);\n  }\n\n  try {\n    await testMarkdownConversion();\n  } catch (e: any) {\n    console.error('  Error:', e.message);\n  }\n\n  try {\n    await testNonExistentUrl();\n  } catch (e: any) {\n    console.error('  Error:', e.message);\n  }\n\n  try {\n    await testPrivateIp();\n  } catch (e: any) {\n    console.error('  Error:', e.message);\n  }\n\n  try {\n    await testValidUrl();\n  } catch (e: any) {\n    console.error('  Error:', e.message);\n  }\n\n  console.log('\\n=== All Tests Complete ===');\n}\n\nif (import.meta.url === `file://${process.argv[1]}`) {\n  runAllTests();\n}\nEOF" action.permission=* action.action=allow action.pattern=*
